{
  "name": "vexa",
  "version": "0.1.0",
  "description": "A simple recorder for your screen, camera, and voice.",
  "main": "./out/main/index.js",
  "author": "Vexa",
  "license": "MIT",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src scripts",
    "build": "electron-vite build",
    "icons": "node scripts/make-icons.mjs",
    "selfcheck": "esbuild scripts/selfcheck.ts --bundle --platform=node --format=cjs --outfile=out/selfcheck.cjs && node out/selfcheck.cjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run icons && npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run icons && npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@3.3.8": true,
    "electron-winstaller@5.4.0": true
  }
}
